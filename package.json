{
  "name": "notebook-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop-first AI note taker with Electron, FastAPI, and LangChain",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace @notebook-ai/desktop run dev",
    "dev:web": "npm --workspace @notebook-ai/web run dev",
    "dev:sidecar": "cd services/local-sidecar && .venv/bin/python -m uvicorn app.main:app --reload --port 8787",
    "dev:cloud": "cd services/cloud-api && .venv/bin/python -m uvicorn app.main:app --reload --port 8790",
    "dev:services": "concurrently -n sidecar,cloud -c blue,magenta \"npm run dev:sidecar\" \"npm run dev:cloud\"",
    "build:desktop": "npm --workspace @notebook-ai/desktop run build",
    "build:web": "npm --workspace @notebook-ai/web run build",
    "test:desktop": "npm --workspace @notebook-ai/desktop run test",
    "version:sync": "node scripts/release/sync-version.mjs",
    "release:notes": "node scripts/release/generate-release-notes.mjs",
    "release:sidecar:mac": "bash scripts/release/build-local-sidecar-macos.sh",
    "release:desktop:mac": "bash scripts/release/package-desktop-macos.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
