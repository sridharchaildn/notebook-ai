{
  "name": "notebook-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop-first AI note taker with Electron, FastAPI, and LangChain",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace @notebook-ai/desktop run dev",
    "dev:web": "npm --workspace @notebook-ai/web run dev",
    "build:desktop": "npm --workspace @notebook-ai/desktop run build",
    "build:web": "npm --workspace @notebook-ai/web run build",
    "test:desktop": "npm --workspace @notebook-ai/desktop run test"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
