# Copy to services/cloud-api/.env. Leave secrets empty.
NOTEBOOK_CLOUD_CREDENTIAL_SECRET=
NOTEBOOK_CLOUD_SUPABASE_URL=http://127.0.0.1:54321
NOTEBOOK_CLOUD_SUPABASE_ANON_KEY=
NOTEBOOK_CLOUD_SUPABASE_SECRET_KEY=
NOTEBOOK_CLOUD_SUPABASE_JWT_SECRET=
NOTEBOOK_CLOUD_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
NOTEBOOK_CLOUD_OPENAI_OAUTH_CLIENT_ID=
NOTEBOOK_CLOUD_OPENAI_OAUTH_CLIENT_SECRET=
