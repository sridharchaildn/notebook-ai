{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "baseUrl": ".",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@notebook-ai/contracts": ["../../packages/contracts/src/index.ts"],
      "@notebook-ai/server-ai": ["../../packages/server-ai/src/index.ts"],
      "@notebook-ai/theme/*": ["../../packages/theme/*"],
      "@notebook-ai/ui": ["../../packages/ui/src/index.tsx"],
      "@notebook-ai/ui/*": ["../../packages/ui/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
